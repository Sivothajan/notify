{
  "name": "@sivothajan/notify",
  "version": "1.0.0",
  "description": "React analytics notify component",
  "author": {
    "name": "Sivothayan",
    "email": "hi@sivothayan.com",
    "url": "https://sivothayan.com"
  },
  "license": "MIT",
  "keywords": [
    "react",
    "analytics",
    "tracking",
    "navigation",
    "page-visits",
    "notification",
    "monitoring"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sivothajan/notify.git"
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "format": "prettier --write .",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --fix"
  },
  "prettier": {
    "printWidth": 80,
    "tabWidth": 2,
    "useTabs": false,
    "semi": true,
    "singleQuote": true,
    "trailingComma": "es5",
    "bracketSpacing": true,
    "arrowParens": "always",
    "endOfLine": "auto"
  },
  "dependencies": {
    "ua-parser-js": "^2.0.9"
  },
  "peerDependencies": {
    "react": "^18 || ^19",
    "express": "^4 || ^5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "5.0.6",
    "@types/react": "^19.2.14",
    "eslint": "^10.0.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "jiti": "^2.6.1",
    "prettier": "^3.8.1",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.55.0"
  },
  "engines": {
    "node": ">=18"
  }
}
